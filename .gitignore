# =============================================================================
# .gitignore — Asterisk Pyramid Generator (Java/Maven)
# =============================================================================
# Defines exclusion rules for build artifacts, compiled classes, IDE metadata,
# and OS-specific files to keep the repository clean.
# =============================================================================

# -----------------------------------------------------------------------------
# Maven Build Artifacts
# -----------------------------------------------------------------------------
# The target/ directory contains all Maven build output including compiled
# classes, packaged JARs, test reports, and intermediate build files.
target/

# -----------------------------------------------------------------------------
# Compiled Java Files
# -----------------------------------------------------------------------------
# Compiled Java bytecode files generated by javac. These should never be
# committed as they are reproducible from source via the build process.
*.class

# -----------------------------------------------------------------------------
# IDE Metadata — IntelliJ IDEA
# -----------------------------------------------------------------------------
# IntelliJ IDEA project configuration directory and module descriptor files.
# Each developer may have different IDE settings; these should remain local.
.idea/
*.iml

# -----------------------------------------------------------------------------
# IDE Metadata — VS Code
# -----------------------------------------------------------------------------
# Visual Studio Code workspace settings, launch configurations, and extensions
# recommendations. These are developer-specific and should not be shared.
.vscode/

# -----------------------------------------------------------------------------
# IDE Metadata — Eclipse
# -----------------------------------------------------------------------------
# Eclipse IDE project metadata files including workspace settings, project
# descriptors, and classpath configuration. Developer-specific.
.settings/
.project
.classpath

# -----------------------------------------------------------------------------
# OS-Specific Files
# -----------------------------------------------------------------------------
# macOS Finder metadata file that stores custom folder attributes.
.DS_Store
# Windows Explorer thumbnail cache file.
Thumbs.db
